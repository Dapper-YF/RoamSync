+def test_durable_worker_lease_retry_uses_original_snapshot_after_later_chat():
+    from datetime import datetime, timedelta, UTC
+    from langgraph.checkpoint.postgres.aio import AsyncPostgresSaver
+    from app.agent_worker import claim_next_run, execute_claimed_run
+    from app.planning_graph_runtime import execute_planning_run
+    with TestClient(app):
+        async def scenario():
+            case=cases()[0]
+            state=await seed_case(case,'phase1a-lease-'+uuid.uuid4().hex)
+            trip_id=uuid.UUID(state['trip_id'])
+            async with session_factory() as db:
+                row=AssistantSession(trip_id=trip_id,messages=[{'id':'original','user':'我喜欢文化，希望轻松一点','assistant':'收到'}],applied_actions={})
+                db.add(row); await db.commit()
+                row=await send_message(db,row.id,'请生成完整行程',uuid.uuid4(),router=Router(ToolDecision(tool='plan_trip',reply='候选',planning_request=state['user_request'])))
+                run=await db.get(PlanningRun,row.latest_run_id)
+                sealed=copy.deepcopy(run.trigger_snapshot['planning_brief'])
+                run.created_at=datetime(1970,1,1,tzinfo=UTC); await db.commit()
+            before=await formal_fingerprint(trip_id)
+            planner=fixture_planner()
+            class InterruptedProvider:
+                async def generate(self,state):
+                    await planner.generate(state)
+                    raise RuntimeError('synthetic worker process interruption before revision persistence')
+            with patch('app.planning_graph._collect_external_facts',AsyncMock(return_value=facts_for(case))),patch('app.candidate_route_service.resolve_route_result',synthetic_route):
+                async with AsyncPostgresSaver.from_conn_string(get_settings().checkpoint_database_url) as saver:
+                    await saver.setup()
+                    with pytest.raises(RuntimeError,match='synthetic worker process interruption'):
+                        await invoke_compiled_graph(build_planning_graph(saver,provider=InterruptedProvider()),run)
+                async with session_factory() as db:
+                    latest=await db.get(PlanningRun,run.id)
+                    assert latest.status=='planning'
+                    latest.worker_lease_expires_at=datetime.now(UTC)-timedelta(seconds=10)
+                    row=await db.get(AssistantSession,row.id)
+                    row.messages=[*row.messages,{'id':'later-retry','user':'我喜欢购物，改得紧凑一点','assistant':'另一次讨论'}]
+                    await db.commit()
+                assert await claim_next_run()==run.id
+                async def execute_owned(run_id):
+                    return await execute_planning_run(run_id,provider=planner)
+                with patch('app.agent_worker.execute_planning_run',execute_owned):
+                    await execute_claimed_run(run.id)
+            assert len(planner.inputs)==2
+            assert planner.inputs[0]['user_requirement_context']==planner.inputs[1]['user_requirement_context']
+            assert planner.inputs[0]['preferences']==planner.inputs[1]['preferences']
+            assert await formal_fingerprint(trip_id)==before
+            async with session_factory() as db:
+                saved=await db.get(PlanningRun,run.id)
+                assert saved.status=='awaiting_confirmation',saved.error_message
+                assert saved.trigger_snapshot['planning_brief']==sealed
+                assert saved.worker_id is None and saved.worker_lease_expires_at is None
+                # A clarify decision cannot bypass the approval boundary.
+                from app.planning_graph_runtime import _validate_decision
+                from app.schemas import PlanningRunDecision
+                with pytest.raises(ValueError,match='waiting for approval'):
+                    _validate_decision(saved,PlanningRunDecision(decision='clarify',answer='确认'))
+            observe('worker-retry',mode='mock_original_graph_postgres_checkpoint',inputs=planner.inputs,
+                immutable_envelope=True,formal_unchanged=True,lease_reclaimed=True,final_status=saved.status)
+        asyncio.run(scenario())
+
