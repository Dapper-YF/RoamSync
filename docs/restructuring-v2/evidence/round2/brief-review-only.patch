+@pytest.mark.parametrize('mode',['brief','legacy','conflict'])
+def test_existing_trip_graph_and_checkpoint_resume_keep_the_original_brief(mode):
+    with TestClient(app):
+        async def scenario():
+            case=cases()[0]
+            state=await seed_case(case,'phase1a-'+mode+'-'+uuid.uuid4().hex)
+            trip_id=uuid.UUID(state['trip_id'])
+            async with session_factory() as db:
+                history=[{'id':'preference','user':'我喜欢文化，希望轻松一点','assistant':'普通会话回复'}]
+                if mode=='conflict': history.append({'id':'current-negative','user':'我不喜欢购物','assistant':'收到'})
+                row=AssistantSession(trip_id=trip_id,messages=history,applied_actions={})
+                db.add(row); await db.commit()
+                if mode=='conflict':
+                    prefs=await db.get(TripPreferences,trip_id); prefs.interest_categories=['shopping']; prefs.pace='intensive'; await db.commit(); await db.refresh(prefs)
+                router=Router(ToolDecision(tool='plan_trip',reply='准备候选',planning_request=state['user_request']))
+                if mode=='legacy':
+                    run=await create_planning_run(db,trip_id,PlanningRunCreate(run_type='initial_plan',user_request=state['user_request']))
+                else:
+                    row=await send_message(db,row.id,'请生成完整行程',uuid.uuid4(),router=router)
+                    run=await db.get(PlanningRun,row.latest_run_id)
+                    assert run.trigger_snapshot['planning_brief']['payload']['requirements']
+                    assert router.seen[0]['planning_brief']['requirements']
+                sealed=copy.deepcopy(run.trigger_snapshot)
+                # Later conversation is explicitly excluded from retry inputs.
+                row.messages=[*row.messages,{'id':'later','user':'我喜欢购物，安排得紧凑','assistant':'稍后讨论'}]
+                await db.commit()
+            before=await formal_fingerprint(trip_id)
+            planner=fixture_planner()
+            checkpoint=InMemorySaver()
+            graph=build_planning_graph(checkpoint,provider=planner)
+            async def route(*args,**kwargs):
+                return SimpleNamespace(distance_meters=1000,duration_minutes=15,provider='Phase1A synthetic route',is_estimated=True,path=[],alternatives=[])
+            with patch('app.planning_graph._collect_external_facts',AsyncMock(return_value=facts_for(case))),patch('app.candidate_route_service.resolve_route_result',route):
+                result=await invoke_compiled_graph(graph,run)
+            assert result.pending_interrupt['kind']=='approval'
+            assert await formal_fingerprint(trip_id)==before
+            wire=planner.inputs[-1]
+            if mode!='legacy':
+                projected=wire['user_requirement_context']
+                assert projected['binding']['payload_sha256']==sealed['planning_brief']['payload_sha256']
+                assert wire['preferences']['pace']=='relaxed'
+                assert wire['preferences']['interest_categories']==['culture']
+                assert '我喜欢购物，安排得紧凑' not in json.dumps(projected,ensure_ascii=False)
+                if mode=='conflict': assert projected['overridden']
+            else: assert wire['user_requirement_context'] is None
+            # Restart graph instance with the same checkpoint: resume approval
+            # performs no second model generation and leaves formal state intact.
+            resumed=build_planning_graph(checkpoint,provider=planner)
+            result=await invoke_compiled_graph(resumed,run,resume={'decision':'reject','answer':None})
+            assert len(planner.inputs)==1
+            assert await formal_fingerprint(trip_id)==before
+            async with session_factory() as db:
+                persisted=await db.get(PlanningRun,run.id)
+                if mode!='legacy':
+                    assert persisted.trigger_snapshot['planning_brief']==sealed['planning_brief']
+                    assert persisted.trigger_snapshot['planning_brief_binding']==sealed['planning_brief_binding']
+                    assert 'decision_context_summary' in persisted.trigger_snapshot
+            observe('graph-'+mode, mode='mock_original_graph', input=wire, sealed=sealed,
+                final=planner.outputs, formal_unchanged=True, model_calls=len(planner.inputs), approval=result.pending_interrupt)
+        asyncio.run(scenario())
