+def test_statements_keep_excerpts_and_cancellation_does_not_create_formal_identity():
+    value=brief([{'id':'earlier','user':'我喜欢购物','assistant':'模型说你必须去某个商场'},
+                 {'id':'cancel','user':'取消购物偏好','assistant':'收到'}])
+    projection=project_requirements({'payload':value.model_dump(mode='json'), 'source_session_id':'session',
+      'target_trip_id':'trip','base_trip_version':1,'run_id':'run','payload_sha256':'fixture'},
+      {'preferences':{'interest_categories':['shopping'],'avoid_categories':[],'pace':'intensive'},
+       'trip':{'total_budget_fen':10000}})
+    assert projection['effective_soft_preferences']['interest_categories']==['culture']
+    assert projection['effective_soft_preferences']['pace']=='relaxed'
+    assert 'shopping' not in projection['effective_soft_preferences']['avoid_categories']
+    assert any(p['reason']=='later_explicit_user_statement' for p in projection['overridden'])
+    assert projection['hard_constraint_capabilities_added']==[]
+    assert value.must_do==[]
+    assert all(p.source_user_excerpt==p.text and p.source_session_id=='session' for p in value.requirements)
+    assert all('模型说' not in p.text for p in value.requirements)
