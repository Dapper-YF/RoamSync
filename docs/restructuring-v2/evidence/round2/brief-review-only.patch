+@pytest.mark.parametrize('change',['hash','trip','session','version','payload','run','authorization'])
+def test_envelope_tampering_rejected_without_reading_latest_chat(change):
+    payload=brief().model_dump(mode='json')
+    envelope={'schema_version':1,'source_session_id':'session','target_trip_id':'trip','base_trip_version':1,
+      'run_id':'run','authorization_turn_id':'authorization','payload':payload,'payload_sha256':digest(payload),
+      'source_turn_digests':{'authorization':'sealed-at-creation'}}
+    binding={k:envelope[k] for k in ('source_session_id','target_trip_id','base_trip_version','run_id','authorization_turn_id','payload_sha256')}
+    binding['envelope_sha256']=digest(envelope)
+    run=SimpleNamespace(id='run',trip_id='trip',base_trip_version=1,trigger_snapshot={'planning_brief':envelope,'planning_brief_binding':binding})
+    assert load_brief(run,1)['payload']==payload
+    if change=='hash': binding['envelope_sha256']='bad'
+    elif change=='version': run.base_trip_version=2
+    elif change=='trip': run.trip_id='other'
+    elif change=='run': run.id='other'
+    elif change=='session': envelope['source_session_id']='other'
+    elif change=='authorization': envelope['authorization_turn_id']='other'
