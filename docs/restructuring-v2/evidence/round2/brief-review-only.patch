+def observe(name, **values):
+    """Synthetic, assertion-backed observations on the same frozen test image."""
+    path=Path('/evidence')
+    if path.is_dir():
+        (path/(name+'.json')).write_text(json.dumps(values,ensure_ascii=False,indent=2,default=str),encoding='utf-8')
+
