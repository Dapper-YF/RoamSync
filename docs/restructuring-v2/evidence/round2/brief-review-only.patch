+@pytest.mark.parametrize('invalid',['missing_binding','invalid_schema','duplicate_statement','stale_trip_version'])
+def test_invalid_envelope_shape_and_old_version_fail_closed(invalid):
+    payload=brief().model_dump(mode='json')
+    envelope={'schema_version':1,'source_session_id':'session','target_trip_id':'trip','base_trip_version':1,
+        'run_id':'run','authorization_turn_id':'authorization','payload':payload,'source_turn_digests':{'authorization':digest('synthetic-user')}}
+    if invalid=='invalid_schema': payload['requirements'][0]['confirmation']='forged'
+    if invalid=='duplicate_statement': payload['requirements'][1]['statement_id']=payload['requirements'][0]['statement_id']
+    envelope['payload_sha256']=digest(payload)
+    binding={k:envelope[k] for k in ('source_session_id','target_trip_id','base_trip_version','run_id','authorization_turn_id','payload_sha256')}
+    binding['envelope_sha256']=digest(envelope)
+    if invalid=='missing_binding': binding.pop('source_session_id')
+    run=SimpleNamespace(id='run',trip_id='trip',base_trip_version=1,trigger_snapshot={'planning_brief':envelope,'planning_brief_binding':binding})
+    with pytest.raises(PlanningBriefError): load_brief(run,2 if invalid=='stale_trip_version' else 1)
+
