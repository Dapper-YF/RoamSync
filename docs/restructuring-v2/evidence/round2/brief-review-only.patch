+class Router:
+    def __init__(self,decision): self.decision=decision; self.seen=[]
+    async def decide(self,context):
+        self.seen.append(copy.deepcopy(context))
+        # Mutating the router's JSON cannot mutate the server's typed Brief.
+        if context.get('planning_brief'): context['planning_brief']['requirements']=[]
+        return self.decision
