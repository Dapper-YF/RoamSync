+                assert revision.status=='pending'
+                current=await db.get(Activity,uuid.UUID(current_id))
+                assert current.status=='active' and current.scheduled_time==time(9)
+            observe('graph-existing-adjust',mode='mock_original_graph',input=wire,final=planner.outputs,
+                target_date=str(target),current_activity_unchanged=True,formal_unchanged=True,interrupt=result.pending_interrupt)
+        asyncio.run(scenario())
