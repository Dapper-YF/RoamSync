--- canonical/backend/app/planning_brief.py
+++ brief/backend/app/planning_brief.py
@@ -0,0 +1,233 @@
+"""Source-bound conversation requirements, using the existing Run JSON snapshot.
+
+This is context transport, not a new hard constraint or identity resolver.
+Public PlanningRunCreate cannot inject this internal envelope.
+"""
+import copy
+import hashlib
+import json
+import re
+from app.companion_contracts import BriefInterest, PlanningBrief, PreferenceStatement
+from pydantic import ValidationError
+
+
+class PlanningBriefError(ValueError):
+    pass
+
+
+def digest(value):
+    return hashlib.sha256(json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
+
+
+def _parse(value):
+    try:
+        return PlanningBrief.model_validate(value)
+    except ValidationError as exc:
+        raise PlanningBriefError('planning_brief_schema_invalid') from exc
+
+
+def _assertion(text):
+    return not re.search(r'[？?]|吗[。！!]*$|假如|假设|如果|你觉得|为什么|是否|会不会', text)
+
+
+def _declarations(brief):
+    return (brief.requirements+brief.confirmed_preferences+brief.user_decisions+
+            list(brief.field_sources.values())+[p.declaration for p in brief.candidate_interests if p.declaration])
+
+
+def _statement(session, turn, excerpt, kind, value, index=0, polarity="positive"):
+    from app.companion_state import stable_identity
+    return PreferenceStatement(text=excerpt[:1000], source_turn_id=turn,
+        source_session_id=session, source_user_excerpt=excerpt[:1000], confirmation="explicit",
+        polarity=polarity, kind=kind, value=value[:1000],
+        statement_id=stable_identity("statement", session, turn, index))
+
+
+def enrich_brief(brief, session, turn, message, messages):
+    from app.companion_state import project_conversation, resolve_suggestions, interaction_status
+    turns = [(str(m.get("id", "legacy")), str(m.get("user", ""))) for m in messages] + [(turn, message)]
+    requirements = []
+    previous = {}
+    categories = {"culture": r"文化|人文|博物馆|历史", "shopping": r"购物|逛街|商业",
+                  "nature": r"自然|公园|登山", "food": r"美食|小吃"}
+    for source_turn, text in turns:
+        # Do not spread a negative preference across a contrasting positive
+        # assertion ("不喜欢购物，但喜欢文化"). Keep excerpts as user substrings.
+        clauses = re.split(r"[，,；;。\n]|但是|不过|但|(?=不(?:太)?喜欢)", text)
+        for clause_index, clause in enumerate(clauses[:20]):
+            if not clause.strip() or not _assertion(clause):
+                continue
+            polarity = "cancelled" if re.search(r"取消|不再|别再|不要再", clause) else "negative" if re.search(r"不(?:太)?喜欢|不想|不要|避开|不去", clause) else "positive"
+            values = []
+            if re.search(r"喜欢|偏好|想|希望|重点|取消|不再|不要|避开", clause):
+                values += [("avoidance" if polarity == "negative" else "preference", key) for key, pattern in categories.items() if re.search(pattern, clause)]
+            pace = next((v for v,p in [("relaxed",r"轻松|慢游|不赶|别太赶"),("intensive",r"紧凑|充实"),("balanced",r"均衡|适中")] if re.search(p,clause)), None)
+            if pace:
+                values.append(("pace", pace))
+            if re.search(r"旅行目标|主要想|重点想|目的是|希望", clause):
+                values.append(("travel_goal", clause))
+            if (re.search(r"必须|必去|一定.{0,20}(?:去|安排|加入|包含|放进)", clause)
+                and not re.search(r"不一定|不必|不需要|无需|没有必要",clause) and polarity == "positive"):
+                values.append(("must_do", clause))
+            for offset, (kind, value) in enumerate(values):
+                item = _statement(session, source_turn, clause, kind, value, clause_index*10+offset, polarity)
+                key = "pace" if kind == "pace" else "category:"+value if value in categories else kind+":"+value
+                if key in previous:
+                    item = item.model_copy(update={'supersedes_refs': [previous[key]]})
+                previous[key] = item.statement_id
+                requirements.append(item)
+    # Preserve existing generic explicit preference statements without inventing
+    # a category when the deterministic vocabulary does not cover the wording.
+    enriched = []
+    for i, item in enumerate(brief.confirmed_preferences):
+        if not _assertion(item.text):
+            continue
+        enriched.append(_statement(session, item.source_turn_id, item.text, "preference", item.text, 900+i,
+            "cancelled" if re.search(r"取消|不再|别再|不要再",item.text) else "negative" if re.search(r"不(?:太)?喜欢|不想|避开",item.text) else "positive"))
+    selections = {}
+    history = []
+    for source_turn, text in turns:
+        selected = []
+        if re.search(r"suggestion_[0-9a-f]{32}|第[一二三四五六七八九十\d]+[个项条]|它|那个地方|那条建议|这个建议",text):
+            state = project_conversation(history)
+            selected, _ = resolve_suggestions(text, state)
+        status = interaction_status(text)
+        for selection_index, suggestion in enumerate(selected):
+            if re.search(r"不想|不要|不喜欢|取消|不去", text):
+                selections.pop(suggestion.suggestion_id, None)
+            elif status in {"user_liked", "user_confirmed", "must_do"} or source_turn == turn:
+                selections[suggestion.suggestion_id] = BriefInterest(suggestion_ref=suggestion.suggestion_id,
+                    display_name=suggestion.title, entity_refs=suggestion.entity_refs, status=status if status != "discussed" else "user_confirmed",
+                    source_turn_ref=suggestion.conversation_turn_id,
+                    declaration=_statement(session, source_turn, text[:1000], "must_do" if status == "must_do" else "preference",
+                                           suggestion.title, 990+selection_index))
+        if source_turn != turn:
+            original = next((m for m in messages if str(m.get("id")) == source_turn), None)
+            if original:
+                history.append(original)
+    interests = list(selections.values())[-10:]
+    requirements = requirements[-60:]
+    # Every rich statement has bounded user provenance; old contracts still
+    # parse with defaults but cannot self-assert confirmation in a new envelope.
+    decisions = [_statement(session,p.source_turn_id,p.text,"decision",p.text,950+i) for i,p in enumerate(brief.user_decisions) if _assertion(p.text)]
+    field_sources = {}
+    for i, key in enumerate(('date_request','party_statement','budget_statement')):
+        value = getattr(brief, key)
+        source = next(((tid, text) for tid,text in reversed(turns) if value and text[:1000]==value), None)
+        if source:
+            field_sources[key] = _statement(session,source[0],source[1],'decision',value,980+i)
+    return brief.model_copy(update={"requirements":requirements, "confirmed_preferences":enriched,
+        "avoidances":[p for p in enriched if p.polarity=="negative"], "user_decisions":decisions,
+        "travel_goals":[p for p in requirements if p.kind=="travel_goal"][-30:],
+        "pace_request":next((p for p in reversed(requirements) if p.kind=="pace"),None),
+        "field_sources":field_sources,
+        "candidate_interests":interests, "must_do":[p.suggestion_ref for p in interests if p.status=="must_do"],
+        "suggestion_refs":[p.suggestion_ref for p in interests],
+        "source_turn_refs":list(dict.fromkeys([p.source_turn_id for p in requirements+enriched+decisions+list(field_sources.values())]+
+            [p.source_turn_ref for p in interests]+[p.declaration.source_turn_id for p in interests]+[turn]))[-60:]})
+
+
+async def bind_brief(db, brief_data, source_session_id, trip_id, version, run_id):
+    from app.database import AssistantSession
+    from app.companion_state import build_planning_brief
+    from app.travel_goal_router import route_travel_goal
+    brief = _parse(brief_data)
+    row = await db.get(AssistantSession, source_session_id)
+    if row is None or row.trip_id != trip_id:
+        raise PlanningBriefError("planning_brief_session_trip_mismatch")
+    matches = [i for i,m in enumerate(row.messages) if str(m.get("id"))==brief.authorization_turn_id]
+    if len(matches)!=1:
+        raise PlanningBriefError("planning_brief_authorization_missing")
+    index = matches[0]
+    source = row.messages[index]
+    raw = str(source.get("user", ""))
+    history = list(row.messages[:index])
+    canonical = build_planning_brief(str(row.id),brief.authorization_turn_id,raw,route_travel_goal(raw, history),history)
+    if canonical is None or canonical.status!="prepared" or canonical.model_dump(mode="json")!=brief.model_dump(mode="json"):
+        raise PlanningBriefError("planning_brief_untrusted_source")
+    payload = brief.model_dump(mode="json")
+    if len(json.dumps(payload,ensure_ascii=False).encode())>48000:
+        raise PlanningBriefError("planning_brief_payload_too_large")
+    proofs = {str(m['id']):digest(str(m.get('user',''))) for m in row.messages[:index+1] if str(m.get('id')) in brief.source_turn_refs}
+    declarations = _declarations(brief)
+    if any(p.source_turn_id not in proofs for p in declarations):
+        raise PlanningBriefError('planning_brief_source_limit_exceeded')
+    envelope = {"schema_version":1, "source_session_id":str(row.id), "target_trip_id":str(trip_id),
+        "base_trip_version":version, "run_id":str(run_id), "authorization_turn_id":brief.authorization_turn_id,
+        "payload":payload, "payload_sha256":digest(payload), "source_turn_digests":proofs}
+    binding = {k:envelope[k] for k in ("source_session_id","target_trip_id","base_trip_version","run_id","authorization_turn_id","payload_sha256")}
+    binding['envelope_sha256'] = digest(envelope)
+    return envelope, binding
+
+
+def load_brief(run, current_version):
+    snapshot = run.trigger_snapshot or {}
+    envelope = snapshot.get('planning_brief')
+    if envelope is None and 'planning_brief' not in snapshot:
+        return None
+    binding = snapshot.get('planning_brief_binding') or {}
+    expected_keys = {'source_session_id','target_trip_id','base_trip_version','run_id','authorization_turn_id','payload_sha256','envelope_sha256'}
+    if not isinstance(binding,dict) or set(binding)!=expected_keys:
+        raise PlanningBriefError('planning_brief_binding_invalid')
+    if not isinstance(envelope,dict) or envelope.get('schema_version')!=1 or digest(envelope)!=binding.get('envelope_sha256'):
+        raise PlanningBriefError('planning_brief_hash_invalid')
+    if envelope.get('target_trip_id')!=str(run.trip_id) or envelope.get('run_id')!=str(run.id):
+        raise PlanningBriefError('planning_brief_run_trip_mismatch')
+    if envelope.get('base_trip_version')!=run.base_trip_version or current_version!=run.base_trip_version:
+        raise PlanningBriefError('planning_brief_stale_version')
+    if any(envelope.get(k)!=binding.get(k) for k in binding if k!='envelope_sha256'):
+        raise PlanningBriefError('planning_brief_binding_invalid')
+    payload = envelope.get('payload')
+    if digest(payload)!=envelope.get('payload_sha256'):
+        raise PlanningBriefError('planning_brief_payload_hash_invalid')
+    brief = _parse(payload)
+    if brief.status!='prepared' or brief.authorization_turn_id!=envelope.get('authorization_turn_id'):
+        raise PlanningBriefError('planning_brief_authorization_invalid')
+    declarations = _declarations(brief)
+    if len({p.statement_id for p in declarations})!=len(declarations):
+        raise PlanningBriefError('planning_brief_statement_identity_invalid')
+    for item in declarations:
+        if (item.source_session_id!=envelope.get('source_session_id') or not item.statement_id or
+            item.source_turn_id not in envelope.get('source_turn_digests',{}) or not item.source_user_excerpt or
+            item.confirmation not in {'explicit','confirmed'}):
+            raise PlanningBriefError('planning_brief_statement_source_invalid')
+    return copy.deepcopy(envelope)
+
+
+def project_requirements(envelope, context):
+    brief = PlanningBrief.model_validate(envelope['payload'])
+    active = {}; overridden=[]
+    for item in brief.requirements:
+        key = 'pace' if item.kind=='pace' else 'category:'+str(item.value) if item.value in {'culture','shopping','nature','food'} else item.kind+':'+str(item.value)
+        if key in active:
+            overridden.append({'statement':active[key].model_dump(mode='json'),'reason':'later_explicit_user_statement', 'by':item.statement_id})
+        active[key]=item
+    defaults=copy.deepcopy(context.get('preferences') or {})
+    effective=copy.deepcopy(defaults)
+    positive=[p.value for p in active.values() if p.value in {'culture','shopping','nature','food'} and p.polarity=='positive']
+    negative=[p.value for p in active.values() if p.value in {'culture','shopping','nature','food'} and p.polarity=='negative']
+    cancelled=[p.value for p in active.values() if p.value in {'culture','shopping','nature','food'} and p.polarity=='cancelled']
+    if positive: effective['interest_categories']=positive
+    effective['interest_categories']=[v for v in effective.get('interest_categories',[]) if v not in negative+cancelled]
+    effective['avoid_categories']=list(dict.fromkeys([v for v in effective.get('avoid_categories',[]) if v not in positive+cancelled]+negative))
+    pace=active.get('pace')
+    if pace and pace.polarity=='positive': effective['pace']=pace.value
+    for key in ['interest_categories','avoid_categories','pace']:
+        if defaults.get(key)!=effective.get(key):
+            overridden.append({'trip_preference_field':key,'previous':defaults.get(key),'effective':effective.get(key),
+                'reason':'explicit_conversation_requirement_over_soft_default','source':'persisted_trip_preferences'})
+    return {'binding':{k:envelope[k] for k in ('source_session_id','target_trip_id','base_trip_version','run_id','payload_sha256')},
+        'active_statements':[p.model_dump(mode='json') for p in active.values()], 'overridden':overridden,
+        'explicit_user_preferences':[p.model_dump(mode='json') for p in brief.confirmed_preferences],
+        'user_decisions':[p.model_dump(mode='json') for p in brief.user_decisions],
+        'date_request':brief.date_request,'party_statement':brief.party_statement,'budget_statement':brief.budget_statement,
+        'field_sources':{k:v.model_dump(mode='json') for k,v in brief.field_sources.items() if k in {'date_request','party_statement','budget_statement'}},
+        'effective_soft_preferences':effective, 'confirmed_suggestions':[{
+            'suggestion_ref':p.suggestion_ref,'display_name':p.display_name,'confirmation':p.status,
+            'source':p.declaration.model_dump(mode='json') if p.declaration else None,
+            'formal_identity_resolved':False} for p in brief.candidate_interests],
+        'user_request':brief.user_request, 'open_questions':brief.open_questions,
+        'semantic_only_kinds':['must_do','travel_goal'],
+        'authority_order':['formal_trip_and_execution','legal_current_request','confirmed_session_preferences','trip_preferences_soft_defaults','unconfirmed_suggestions'],
+        'formal_constraints':{k:context.get('trip',{}).get(k) for k in ('destination','start_date','end_date','total_budget_fen','daily_budget_fen')},
+        'hard_constraint_capabilities_added':[]}
