+                run=await db.get(PlanningRun,row.latest_run_id)
+                assert run.run_type=='replan'
+                current_id=str(current.id)
+            before=await formal_fingerprint(trip_id)
+            planner=fixture_planner()
+            with patch('app.planning_graph._collect_external_facts',AsyncMock(return_value=facts_for({**case,'date':str(target)}))),patch('app.candidate_route_service.resolve_route_result',synthetic_route):
+                result=await invoke_compiled_graph(build_planning_graph(InMemorySaver(),provider=planner),run)
+            assert result.pending_interrupt['kind']=='approval'
+            wire=planner.inputs[0]
+            assert wire['allowed_dates']==[str(target)]
+            assert wire['execution_state']['current_activity']['name']==state['planning_context']['candidates'][0]['name']
+            assert wire['preferences']['interest_categories']==['culture']
+            assert await formal_fingerprint(trip_id)==before
+            async with session_factory() as db:
