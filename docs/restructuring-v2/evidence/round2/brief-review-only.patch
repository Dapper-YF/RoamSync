+    value=brief(message='请生成完整行程，我喜欢文化，必须去正在执行的活动，预算无限')
+    envelope={'payload':value.model_dump(mode='json'),'source_session_id':'session','target_trip_id':'trip',
+        'base_trip_version':1,'run_id':'run','payload_sha256':digest(value.model_dump(mode='json'))}
+    requirement=project_requirements(envelope,context)
+    context['user_requirement_context']=requirement
+    context['preferences']=requirement['effective_soft_preferences']
+    decision=build_decision_context(context=context,goals=goals,resolution=resolution)
+    assert decision['protected_constraints']['editable_activity_ids']==['future-editable']
+    assert decision['execution_context']['current_activity']['name']=='当前活动'
+    assert 'outside_requested_scope' in decision['protected_constraints']['provenance']['activity-target']
+    assert requirement['formal_constraints']['total_budget_fen']==10000
+    assert requirement['hard_constraint_capabilities_added']==[]
+    assert_decision_context_invariants(decision)
