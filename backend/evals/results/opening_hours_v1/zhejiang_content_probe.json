          },
          {
            "tag_ids": "",
            "visible": true,
            "create_time": "2026-08-28T09:55:18",
            "content_id": 46530,
            "author": null,
            "thumbImg": "/cms-file/6a914cd8ee9c024669de757c.png",
            "description": null,
            "sort": 10000,
            "source": "办公室",
            "title": "【通知公告】浙江省博物馆临时闭馆公告",
            "content": "<p style=\"line-height: 2;\"><span style=\"font-size: 14pt;\">尊敬的各位观众：</span></p>\n<p style=\"line-height: 2; text-indent: 2em; text-align: left;\"><span style=\"font-size: 14pt;\">受今年第18号台风&ldquo;沙德尔&rdquo;的影响，根据《浙江省防汛防台抗旱应急预案》相关要求，为确保居民和观众的生命财产安全，浙江省博物馆于8月28日起临时闭馆，不进行任何参观或活动。在闭馆时段已预约&ldquo;再现圆明园&rdquo;特展、&ldquo;太平年&middot;天下同宁展&rdquo;暨《韩熙载夜宴图》特展的观众，请根据个人行程重新预约，由此给您带来不便，敬请谅解！具体恢复开放时间将通过本馆微信公众号、微博、小红书、网站等官方账号另行通知。本次临时闭馆涉及场所：浙江省博物馆之江馆区、孤山馆区、黄宾虹纪念室、沙孟海旧居。闭馆期间，馆内所有线下文化活动同步暂停，后续安排敬请留意官方通告。</span></p>\n<p style=\"line-height: 2; text-indent: 2em; text-align: right;\"><span style=\"font-size: 14pt;\">浙江省博物馆</span></p>\n<p style=\"line-height: 2; text-align: right;\"><span style=\"font-size: 14pt;\">2026年8月27日</span></p>\n<p style=\"line-height: 2; text-align: right;\">&nbsp;</p>",
            "extension5": null,
            "extension6": null,
            "extension3": null,
            "update_time": "2026-08-31T11:31:01",
            "file": "",
            "extension4": null,
            "subTitle": null,
            "extension1": null,
            "extension2": null,
            "group_id": null,
