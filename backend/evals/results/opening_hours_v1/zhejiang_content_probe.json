          },
          {
            "tag_ids": "",
            "visible": true,
            "create_time": "2026-08-28T15:00:44",
            "content_id": 46531,
            "author": null,
            "thumbImg": "/cms-file/6a914ccaee9c024669de757b.jpg",
            "description": null,
            "sort": 10000,
            "source": "办公室",
            "title": "【通知公告】浙江省博物馆恢复开放公告",
            "content": "<p style=\"line-height: 2;\"><span style=\"font-size: 14pt;\">尊敬的各位观众：</span></p>\n<p style=\"line-height: 2; text-indent: 2em;\"><span style=\"font-size: 14pt;\">第18号台风&ldquo;沙德尔&rdquo;对杭州的影响逐渐减弱，杭州市防汛防台抗旱指挥部已将防台风应急响应降至III级。浙江省博物馆之江馆区将于8月28日下午15:30起恢复对外开放，开放区域为一楼&ldquo;浙江一万年&rdquo;通史A展厅、&ldquo;再现圆明园&rdquo;展厅，二楼&ldquo;太平年&middot;天下同宁&rdquo;展厅，今天夜间延时开放至21:30，21:00停止入馆。孤山馆区、黄宾虹纪念室、沙孟海旧居将于8月29日起对外开放。已成功预约8月28日&ldquo;再现圆明园&rdquo;特展及&ldquo;太平年&middot;天下同宁展&rdquo;暨《韩熙载夜宴图》特展，但当日未能到场的观众，可于本馆后续任意开放日，持8月28日预约记录及本人实体身份证件原件，前往相应展厅核销核验后入场参观。</span></p>\n<p style=\"line-height: 2; text-indent: 2em;\"><span style=\"font-size: 14pt;\">雨霁风歇，美好如故，期待与各位观众再度相逢！</span></p>\n<p style=\"line-height: 2;\">&nbsp;</p>\n<p style=\"line-height: 2; text-align: right;\"><span style=\"font-size: 14pt;\">浙江省博物馆</span></p>\n<p style=\"line-height: 2; text-align: right;\"><span style=\"font-size: 14pt;\">2026年8月28日</span></p>",
            "extension5": null,
            "extension6": null,
            "extension3": null,
            "update_time": "2026-08-28T19:58:19",
            "file": "",
            "extension4": null,
            "subTitle": null,
            "extension1": null,
            "extension2": null,
            "group_id": null,
            "linkUrl": null,
            "id": 46531,
