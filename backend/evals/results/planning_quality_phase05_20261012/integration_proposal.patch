+@pytest.mark.parametrize("preservation", [
+    "保留整体三天（2026-10-09至2026-10-11）框架与其他日期不变",
+    "保留整体三天(2026-10-09至2026-10-11)框架与其他日期不变",
+    "保留其他日期不变",
+    "保留其他日期安排不变",
+])
+def test_day_candidate_edit_plan_frame_is_not_a_missing_activity(preservation):
+    with TestClient(app) as client:
+        trip = client.post("/api/v1/trips", json={
+            "title": "南京候选编辑回归", "destination": "南京",
+            "start_date": "2026-10-09", "end_date": "2026-10-11",
+            "total_budget_fen": 300000, "daily_budget_fen": 100000,
+        }).json()
+        before = client.get(f"/api/v1/trips/{trip['id']}/days").json()
+        message = f"请调整当前行程：把2026年10月10日的安排放轻松一些，减少当天活动密度和赶场，{preservation}，仅给出新的候选方案，不直接保存为正式行程。"
+        result = client.post(f"/api/v1/trips/{trip['id']}/planning-intent/resolve", json={"message": message}).json()
+        assert not result["requires_clarification"], result
+        assert result["grounded_intent"]["target_day_ids"] == [before[1]["id"]]
+        assert result["grounded_intent"]["target_activity_ids"] == []
+        assert client.get(f"/api/v1/trips/{trip['id']}/days").json() == before
+        assert client.get(f"/api/v1/trips/{trip['id']}").json()["version"] == trip["version"]
+
+
