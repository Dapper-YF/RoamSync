+}
+function repository(accept = vi.fn().mockResolvedValue({}), reject = vi.fn().mockResolvedValue({})) { return { acceptPlanRevision: accept, rejectPlanRevision: reject } as unknown as TripPlanningRepository; }
+
+describe("RecoveryPanel", () => {
