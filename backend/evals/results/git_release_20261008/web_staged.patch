+.ai-panel .ai-composer-shell textarea::placeholder { color: #94a399; }
+.ai-panel .ai-composer-actions { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 2px 7px 7px 13px; }
+.ai-panel .ai-composer-actions > span { display: flex; align-items: center; gap: 5px; color: #697c66; font-size: 10px; white-space: nowrap; }
+.ai-panel .ai-composer-actions .ai-send { min-height: 38px; padding: 9px 15px; border: 0; border-radius: 22px; background: #245f51; color: white; box-shadow: 0 4px 9px rgb(32 85 70 / 15%); font-size: 12px; font-weight: 600; }
+.ai-panel .ai-composer-actions .ai-send:disabled { opacity: 1; background: #e6ede5; color: #94a58f; box-shadow: none; }
+.ai-panel .ai-send-spinner { animation: spin 1.1s linear infinite; }
+.ai-panel .ai-composer > small { display: flex; justify-content: center; align-items: center; gap: 4px; color: #6d7c66; font-size: 10px; line-height: 1.6; }
+.ai-panel .ai-composer kbd { font: inherit; }
+.ai-panel .ai-shortcut-divider { padding: 0 4px; color: #b6c1b1; }
+.ai-panel button { transition: background .18s, box-shadow .18s, transform .18s, border-color .18s; }
+.ai-panel button:not(:disabled):hover { filter: brightness(.97); transform: translateY(-1px); }
+.ai-panel button:not(:disabled):active { transform: translateY(0); }
+.ai-panel button:focus-visible, .ai-panel summary:focus-visible { outline: 3px solid #9ac4a9; outline-offset: 3px; }
+.ai-panel button:disabled { transform: none; }
+@media (max-width: 600px) {
+  .drawer-backdrop.ai-backdrop { padding: 0; }
+  .ai-backdrop .ai-panel { width: 100%; max-width: 100%; border: 0; border-radius: 0; }
+  .ai-panel > header { padding: 20px 20px 16px; gap: 10px; }
+  .ai-panel .ai-heading h2 { font-size: 22px; }
+  .ai-panel .ai-reset,
+  .ai-panel .ai-monitor-link { padding: 8px; font-size: 0; }
+  .ai-panel .ai-monitor-link svg { width: 17px; height: 17px; }
+  .ai-panel .ai-avatar { width: 46px; height: 46px; border-radius: 17px; }
+  .ai-panel .ai-conversation { padding: 20px 16px; gap: 18px; }
+  .ai-panel .ai-proposal { padding: 18px 16px; border-radius: 22px; }
+  .ai-panel .ai-message { max-width: 97%; padding: 14px 16px; }
+  .ai-panel .proposal-heading > span { font-size: 16px; }
+  .ai-panel .proposal-impact { gap: 6px; }
+  .ai-panel .proposal-impact span { padding: 9px; }
+  .ai-panel > footer.ai-composer { padding: 12px 14px max(12px, env(safe-area-inset-bottom)); }
+  .ai-panel .ai-composer-actions > span { font-size: 9px; }
+  .ai-panel .ai-composer-actions .ai-send { padding: 10px 12px; min-height: 40px; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .ai-backdrop .ai-panel, .ai-panel button, .ai-panel .ai-send-spinner, .ai-panel .ai-message.working svg { animation: none; transition: none; }
+  .ai-panel button:not(:disabled):hover { transform: none; }
+}
+.ai-panel .ai-progress-detail { display: block; margin-top: 7px; color: #687d74; font-size: 12px; line-height: 1.6; }
