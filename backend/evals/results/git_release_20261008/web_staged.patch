+.ai-panel .ai-composer-shell { padding: 4px; border: 1px solid #d6e3d8; border-radius: 23px; background: white; box-shadow: 0 3px 12px rgb(50 79 60 / 4%); transition: border-color .2s, box-shadow .2s; }
