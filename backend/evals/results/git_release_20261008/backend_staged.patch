+@pytest.mark.parametrize("text,hours",[("杭州明天下午天气怎么样？",6),("杭州明天会下雨吗？",24),("10月2日下午南京天气如何？",6),("南京后天上午天气如何？",6),("杭州明天晚上天气？",6),("杭州今天晚上天气？",6)])
