+"""Reviewed official CMS collectors. Published schedules do not assert live operation."""
+import asyncio
+import html
+import json
+import re
+from datetime import UTC, datetime, timedelta
+from urllib.parse import urlencode
+from urllib.request import Request, urlopen
+from zoneinfo import ZoneInfo
+
+from .models import FactBundle, FactType, OpeningHoursValue, TimeScope
+from .normalization import evidence_record, fact_record
+
+ZONE = ZoneInfo("Asia/Shanghai")
+VENUES = {
+    "amap:B001907TGR": ("南京博物院", "南京", "nanjing_museum", 381205),
+    "amap:B0I15SU50Z": ("浙江省博物馆之江馆区", "杭州", "zhejiang_museum", 46554),
+}
+SOURCES = {
+    "nanjing_museum": ("https://www.njmuseum.com/api/news/freshNotice", {"language": "zh"}, True),
+    "zhejiang_museum": ("https://www.zjmuseum.com.cn/api/content/page", {"siteId": 22, "categoryCode": "Notice", "pageNum": 1, "pageSize": 10}, False),
+}
+
+async def official_gateway(provider):
+    url, data, form = SOURCES[provider]
+    def fetch():
+        body = (urlencode(data) if form else json.dumps(data)).encode()
+        request = Request(url, data=body, headers={"Content-Type": "application/x-www-form-urlencoded" if form else "application/json"})
+        with urlopen(request, timeout=12) as response:
+            raw = response.read(1_048_577)
+        if len(raw)>1_048_576: raise ValueError("official response too large")
+        return json.loads(raw)
+    payload = await asyncio.to_thread(fetch)
+    return payload
+
+def plain(body):
+    return html.unescape(re.sub(r"<[^>]+>", "", body))
+
+def reviewed_schedule(provider, payload, target):
+    """Only reviewed 2026 notice grammar; changes fail closed, never model extraction."""
+    if provider == "nanjing_museum":
+        if payload.get("code") != 0: raise ValueError("official CMS status")
+        notices=payload["data"]["list"]
+        selected=[n for n in notices if n.get("id")==381205 and n.get("time")=="2026-09-17"]
+        if len(selected)!=1: return None
+        notice=selected[0]; body=plain(notice["introduction"])
+        # A newer opening/closure notice cannot be silently ignored. Gallery
+        # announcements do not become whole-museum closure records.
+        if any(n.get("time", "")>notice["time"] and re.search(r"开放|闭馆|闭院|暂停",n.get("title","")) for n in notices):
+            return None
+        if "2026年中秋、国庆" not in body: return None
+        if re.search(r"暂停|临时闭馆|维修|停止开放",body): return None
+        if "闭馆" in body.replace("10月5日（周一）不闭馆", ""): return None
+        grammar=r"(\d+)月(\d+)日(?:-(\d+)月(\d+)日)?开放时间(?:为|恢复为)(\d+):(\d+)—(\d+):(\d+)（(\d+):(\d+)停止入馆）"
+        rows=re.findall(grammar,body)
+        if len(rows)!=4: return None
+        publication=notice["time"]
+        updated="unknown"
+        url="https://www.njmuseum.com/zh/newsDetails?id=381205"
+    else:
+        if payload.get("success") is not True: raise ValueError("official CMS status")
+        notices=payload["data"][2]
+        selected=[n for n in notices if n.get("content_id")==46554 and n.get("create_time","").startswith("2026-09-")]
+        if len(selected)!=1: return None
+        notice=selected[0]
+        if any(n.get("create_time", "")>notice["create_time"] and re.search(r"开放|开馆|闭馆|暂停",n.get("title","")) for n in notices): return None
+        body=plain(notice["content"])
+        if "之江馆区" not in body or "孤山馆区" not in body: return None
+        body=body.split("之江馆区",1)[1].split("孤山馆区",1)[0]
+        # Year is established by the dated official publication plus reviewed
+        # 2026 weekday consistency, not current year or a model guess.
+        grammar=r"(\d+)月(\d+)日（周[一二三四五六日]）(?:至(\d+)月(\d+)日（周[一二三四五六日]）)?场馆开放时间为(\d+):(\d+)-(\d+):(\d+)，(\d+):(\d+)停止入馆"
+        rows=re.findall(grammar,body)
+        if len(rows)!=3: return None
+        for month,day,weekday in re.findall(r"(\d+)月(\d+)日（周([一二三四五六日])）",body):
+            if datetime(2026,int(month),int(day)).weekday()!="一二三四五六日".index(weekday): return None
+        publication=notice.get("publish_date") or "unknown"
+        updated=notice.get("update_time") or "unknown"
+        url="https://www.zjmuseum.com.cn/cn/#/Notice"
+        if re.search(r"暂停|临时闭馆|维修|停止开放",body) or body.count("闭馆")!=2: return None
+        for month,day in re.findall(r"(\d+)月(\d+)日（周[一二三四五六日]）闭馆",body):
+            if target==datetime(2026,int(month),int(day)).date():
+                return dict(closed=True,publication=publication,updated=updated,url=url,notice_id=46554,body=body,semantics="special_exception")
+    for m,d,em,ed,oh,om,ch,cm,ah,am in rows:
+        first=datetime(2026,int(m),int(d)).date()
+        last=datetime(2026,int(em or m),int(ed or d)).date()
+        if first<=target<=last:
+            return dict(closed=False,open=f"{int(oh):02}:{int(om):02}",close=f"{int(ch):02}:{int(cm):02}",
+                admission=f"{int(ah):02}:{int(am):02}",publication=publication,updated=updated,url=url,notice_id=notice.get("id",notice.get("content_id")),
+                body=body,semantics="date_specific_schedule")
+    return None
+
+class OfficialOpeningHoursAdapter:
+    name, read_through = "official_opening_hours", True
+    def __init__(self, freshness, gateway=official_gateway, clock=lambda:datetime.now(UTC)):
+        self.freshness,self.gateway,self.clock=freshness,gateway,clock
+    def supports(self, req): return req.fact_type==FactType.OPENING_HOURS and req.subject.ref in VENUES
+    async def fetch(self, req, *, now):
+        venue=VENUES[req.subject.ref]
+        if req.subject.name!=venue[0] or req.subject.destination!=venue[1] or req.time_scope is None: return FactBundle()
+        start=req.time_scope.start.astimezone(ZONE)
+        if start.time()!=datetime.min.time() or req.time_scope.end!=start+timedelta(days=1): return FactBundle()
+        payload=await self.gateway(venue[2]); retrieved=self.clock()
+        schedule=reviewed_schedule(venue[2],payload,start.date())
+        if schedule is None: return FactBundle()
+        def local(time): return datetime.fromisoformat(f"{start.date()}T{time}:00").replace(tzinfo=ZONE)
+        intervals=() if schedule["closed"] else (TimeScope(start=local(schedule["open"]),end=local(schedule["close"])),)
+        value=OpeningHoursValue(intervals=intervals,closed_all_day=schedule["closed"],local_date=str(start.date()),timezone=ZONE.key,
+            schedule_semantics=schedule["semantics"],last_admission=None if schedule["closed"] else local(schedule["admission"]))
+        evidence=evidence_record(provider=venue[2],source_type="official_notice",source_reference=schedule["url"],retrieved_at=retrieved,
+            authority_level="authoritative",normalized_snapshot={"notice_id":schedule["notice_id"],"value":value.model_dump(mode="json")},
+            raw_payload=payload,metadata={"publication_time":schedule["publication"],"last_updated":schedule["updated"],"source_timezone":"not_supplied","exception_coverage":"published_notice_only",
+                "closure_absence_verified":False,"identity_ref":req.subject.ref,"source_api":SOURCES[venue[2]][0]})
+        fact=fact_record(fact_type=req.fact_type,subject=req.subject,value=value,evidence=evidence,freshness=self.freshness,
+            nature="provider_assertion",effective_from=start,effective_until=start+timedelta(days=1),specificity="time_specific")
+        return FactBundle(facts=(fact,),evidence=(evidence,))
diff --git a/backend/app/travel_facts/policies.py b/backend/app/travel_facts/policies.py
new file mode 100644
index 0000000..aec4757
--- /dev/null
+++ b/backend/app/travel_facts/policies.py
@@ -0,0 +1,85 @@
+"""Explicit per-type policies. No universal TTL or LLM source ranking."""
+from datetime import datetime, timedelta
+from typing import Mapping
+
+from pydantic import Field
+
+from .models import AuthorityLevel, Contract, EvidenceRecord, FactRequirement, FactType, FreshnessStatus, TravelFact
+
+LEVEL_ORDER = {AuthorityLevel.UNVERIFIED:0, AuthorityLevel.SECONDARY:1,
+               AuthorityLevel.SPECIALIST:2, AuthorityLevel.AUTHORITATIVE:3}
+LIVE_NO_STALE = {FactType.NAV_ETA, FactType.NAV_POSITION, FactType.NAV_REMAINING_DISTANCE,
+                 FactType.ROUTE_ETA, FactType.WEATHER_CURRENT, FactType.TICKET_AVAILABILITY,
+                 FactType.ACTIVITY_STATUS}
+
+
+class FreshnessRule(Contract):
+    max_age_seconds: int = Field(gt=0)
+    stale_grace_seconds: int = Field(default=0, ge=0)
+
+
+class FactFreshnessPolicy:
+    def __init__(self, rules: Mapping[FactType, FreshnessRule]):
+        # No built-in production TTL: the composition root must choose policies.
+        self.rules = dict(rules)
+
+    def fresh_until(self, fact_type: FactType, retrieved_at: datetime, *, provider_observed_at: datetime | None = None) -> datetime:
+        rule = self.rules[fact_type]
+        return min(retrieved_at, provider_observed_at or retrieved_at) + timedelta(seconds=rule.max_age_seconds)
+
+    def deadline(self, fact: TravelFact, requirement: FactRequirement, evidence: Mapping[str, EvidenceRecord]) -> datetime:
+        anchor = min([fact.observed_at] + [min(evidence[ref].retrieved_at,
+                     evidence[ref].provider_observed_at or evidence[ref].retrieved_at) for ref in fact.evidence_refs])
+        maximum = self.rules[fact.fact_type].max_age_seconds
+        if requirement.required_freshness_seconds is not None:
+            maximum = min(maximum, requirement.required_freshness_seconds)
+        return min(fact.fresh_until, anchor + timedelta(seconds=maximum))
+
+    def classify(self, fact: TravelFact, requirement: FactRequirement, evidence: Mapping[str, EvidenceRecord], *, now: datetime) -> FreshnessStatus:
+        if any(ref not in evidence for ref in fact.evidence_refs):
+            return FreshnessStatus.NO_EVIDENCE
+        if fact.observed_at > now or any(evidence[ref].retrieved_at > now for ref in fact.evidence_refs):
+            return FreshnessStatus.FUTURE_EFFECTIVE
+        target = requirement.time_scope.start if requirement.time_scope else now
+        end = requirement.time_scope.end if requirement.time_scope else None
+        if (target > now and fact.effective_until is None
+            and (fact.fact_type in LIVE_NO_STALE or fact.fact_type == FactType.OPERATIONAL_STATUS)):
+            return FreshnessStatus.FUTURE_EFFECTIVE  # Current records don't promise future state.
+        if fact.effective_from is not None and fact.effective_from > target:
+            return FreshnessStatus.FUTURE_EFFECTIVE
+        if fact.effective_until is not None and (fact.effective_until <= target or (end is not None and fact.effective_until < end)):
+            return FreshnessStatus.EXPIRED
+        return FreshnessStatus.FRESH if now < self.deadline(fact, requirement, evidence) else FreshnessStatus.STALE
+
+    def stale_allowed(self, fact: TravelFact, requirement: FactRequirement, evidence: Mapping[str, EvidenceRecord], *, now: datetime) -> bool:
+        rule = self.rules[fact.fact_type]
+        return (requirement.allow_stale and fact.fact_type not in LIVE_NO_STALE and rule.stale_grace_seconds > 0
+                and now < self.deadline(fact, requirement, evidence) + timedelta(seconds=rule.stale_grace_seconds))
+
+
+class AuthorityRule(Contract):
+    level: AuthorityLevel
+    rank: int = Field(ge=0, le=100)
+
+
+class FactAuthorityPolicy:
+    def __init__(self, rules: Mapping[tuple[FactType, str, str], AuthorityRule] | None = None):
+        self.rules = dict(rules or {})
+
+    @classmethod
+    def existing_providers(cls):
+        rules = {}
+        for kind in (FactType.PLACE_IDENTITY, FactType.PLACE_LOCATION, FactType.PLACE_CATEGORY,
+                     FactType.ROUTE_DISTANCE, FactType.ROUTE_DURATION):
+            rules[kind, "amap", "structured_api"] = AuthorityRule(level="specialist", rank=80)
+        for kind in (FactType.WEATHER_FORECAST, FactType.WEATHER_CURRENT):
+            rules[kind, "open_meteo", "structured_api"] = AuthorityRule(level="specialist", rank=80)
+        for kind in (FactType.ACTIVITY_STATUS, FactType.ACTUAL_START, FactType.ACTUAL_END,
+                     FactType.NAV_POSITION, FactType.NAV_ETA, FactType.NAV_REMAINING_DISTANCE):
+            rules[kind, "roamsync", "canonical_execution"] = AuthorityRule(level="authoritative", rank=100)
+        # Tavily/search_candidate never gets fact authority. Official publishers
+        # require explicit trusted collector registration, not a claimed label.
+        return cls(rules)
+
+    def assess(self, fact_type: FactType, evidence: EvidenceRecord) -> AuthorityRule:
+        return self.rules.get((fact_type, evidence.provider, evidence.source_type), AuthorityRule(level="unverified", rank=0))
diff --git a/backend/app/travel_facts/repository.py b/backend/app/travel_facts/repository.py
new file mode 100644
index 0000000..c747654
--- /dev/null
+++ b/backend/app/travel_facts/repository.py
@@ -0,0 +1,47 @@
+"""Bounded ephemeral evidence cache; canonical execution is never copied here."""
+import json
+from collections import OrderedDict
+
+from .models import FactBundle, FactRequirement
+
+
+def identity_key(fact_type, subject) -> str:
+    return fact_type.value + ":" + json.dumps(subject.model_dump(mode="json"), sort_keys=True, separators=(",", ":"))
+
+
+class InMemoryFactRepository:
+    def __init__(self, *, max_subjects: int = 128, history_per_subject: int = 8):
+        if max_subjects < 1 or history_per_subject < 1:
+            raise ValueError("cache limits must be positive")
+        self.max_subjects, self.history_per_subject = max_subjects, history_per_subject
+        self._bundles: OrderedDict[str, FactBundle] = OrderedDict()
+
+    async def get(self, requirement: FactRequirement) -> FactBundle:
+        return self._bundles.get(identity_key(requirement.fact_type, requirement.subject), FactBundle()).model_copy(deep=True)
+
+    async def merge(self, bundle: FactBundle) -> None:
+        if any(f.fact_type.value.startswith(("execution.", "navigation.")) for f in bundle.facts):
+            raise ValueError("canonical execution facts must use read-through, not cache persistence")
+        all_evidence = {e.id:e for b in self._bundles.values() for e in b.evidence}
+        all_facts = {f.id:f for b in self._bundles.values() for f in b.facts}
+        for record in bundle.evidence:
+            if record.id in all_evidence and all_evidence[record.id] != record:
+                raise ValueError("evidence identity collision")
+        for fact in bundle.facts:
+            if fact.id in all_facts and all_facts[fact.id] != fact:
+                raise ValueError("fact identity collision")
+        evidence = {**all_evidence, **{e.id:e for e in bundle.evidence}}
+        updated = self._bundles.copy()
+        grouped = {}
+        for fact in bundle.facts:
+            grouped.setdefault(identity_key(fact.fact_type, fact.subject), []).append(fact)
+        for key, incoming in grouped.items():
+            prior = updated.get(key, FactBundle())
+            facts = {f.id:f for f in (*prior.facts, *incoming)}
+            ordered = sorted(facts.values(), key=lambda f:(f.observed_at, f.id))[-self.history_per_subject:]
+            refs = {ref for fact in ordered for ref in fact.evidence_refs}
+            updated[key] = FactBundle(facts=tuple(ordered), evidence=tuple(evidence[ref] for ref in sorted(refs))).model_copy(deep=True)
+            updated.move_to_end(key)
+        while len(updated) > self.max_subjects:
+            updated.popitem(last=False)
+        self._bundles = updated  # Atomic after all validation succeeds.
diff --git a/backend/app/travel_facts/resolution.py b/backend/app/travel_facts/resolution.py
new file mode 100644
index 0000000..b64ff6c
--- /dev/null
+++ b/backend/app/travel_facts/resolution.py
@@ -0,0 +1,74 @@
+"""Deterministic resolution preserves disagreements, exclusions and sources."""
+from datetime import datetime
+from zoneinfo import ZoneInfo
+
+from .models import FactBundle, FactRequirement, FreshnessStatus, RejectedCandidate, ResolvedFact
+from .policies import FactAuthorityPolicy, FactFreshnessPolicy, LEVEL_ORDER
+
+
+def resolve_bundle(requirement: FactRequirement, bundle: FactBundle, freshness: FactFreshnessPolicy,
+                   authority: FactAuthorityPolicy, *, now: datetime) -> ResolvedFact:
+    evidence = {record.id:record for record in bundle.evidence}
+    matching = [fact for fact in bundle.facts if fact.fact_type == requirement.fact_type and fact.subject == requirement.subject]
+    refs = {ref for fact in matching for ref in fact.evidence_refs}
+    preserved = tuple(evidence[ref] for ref in sorted(refs))
+    base = dict(requirement=requirement, resolved_at=now, evidence=preserved)
+    if requirement.fact_type not in freshness.rules:
+        return ResolvedFact(**base, resolution_status="unsupported", reasons=("freshness_policy_not_configured",))
+    eligible, stale, rejected = [], [], []
+    for fact in matching:
+        status = freshness.classify(fact, requirement, evidence, now=now)
+        assessments = [authority.assess(fact.fact_type, evidence[ref]) for ref in fact.evidence_refs]
+        assessment = max(assessments, key=lambda rule:(LEVEL_ORDER[rule.level], rule.rank))
+        enough = assessment.rank > 0 and LEVEL_ORDER[assessment.level] >= LEVEL_ORDER[requirement.minimum_authority]
+        priority = (assessment.rank, int(fact.specificity == "time_specific"))
+        unknown = getattr(fact.value, "status", None) == "unknown" or getattr(fact.value, "unknown", False)
+        local_date=getattr(fact.value,"local_date",None)
+        date_mismatch=bool(local_date and (not requirement.time_scope or
+            str(requirement.time_scope.start.astimezone(ZoneInfo(fact.value.timezone)).date())!=local_date))
+        if date_mismatch: enough=False
+        if enough and status == FreshnessStatus.FRESH and not unknown:
+            eligible.append((fact, priority))
+        else:
+            rejected.append(RejectedCandidate(fact=fact, freshness_status=status,
+                reason="opening_date_mismatch" if date_mismatch else "provider_status_unknown" if unknown else "insufficient_registered_authority" if not enough else status.value))
+            if enough and not unknown and status == FreshnessStatus.STALE and freshness.stale_allowed(fact, requirement, evidence, now=now):
+                stale.append((fact, priority))
+    base["rejected_candidates"] = tuple(rejected)
+    using_stale = not eligible
+    pool = eligible or stale
+    if not pool:
+        return ResolvedFact(**base, resolution_status="stale" if any(r.freshness_status == FreshnessStatus.STALE for r in rejected) else "no_evidence",
+            freshness_status=FreshnessStatus.STALE if any(r.freshness_status == FreshnessStatus.STALE for r in rejected)
+                else rejected[0].freshness_status if rejected else FreshnessStatus.NO_EVIDENCE,
+            reasons=("no_usable_evidence",))
+    best_priority = max(priority for _,priority in pool)
+    top = [fact for fact,priority in pool if priority == best_priority]
+    if any(fact.value != top[0].value for fact in top):
+        # Newer revision may supersede an older value ONLY within the exact
+        # same provenance chain, not between independent conflicting sources.
+        chains = {tuple((evidence[ref].provider, evidence[ref].source_type, evidence[ref].source_reference)
+                        for ref in fact.evidence_refs) for fact in top}
+        newest = max(f.observed_at for f in top)
+        recent = [f for f in top if f.observed_at == newest]
+        if len(chains) == 1 and all(f.value == recent[0].value for f in recent):
+            top = recent
+        else:
+            return ResolvedFact(**base, resolution_status="conflicting", freshness_status=FreshnessStatus.STALE if using_stale else FreshnessStatus.FRESH,
+                conflicting_facts=tuple(top), conflicting_evidence=tuple(evidence[ref] for ref in sorted({r for f in top for r in f.evidence_refs})),
+                reasons=("equal_policy_priority_disagreement",))
+    selected = sorted(top, key=lambda fact:(-fact.observed_at.timestamp(), fact.id))[0]
+    supporting = {ref for fact,_ in pool if fact.value == selected.value for ref in fact.evidence_refs}
+    conflicts = tuple(fact for fact in matching if fact.value != selected.value)
+    conflict_refs = {ref for fact in conflicts for ref in fact.evidence_refs}
+    corroborated = len({evidence[ref].provider for ref in supporting}) > 1
+    simulation = any(evidence[ref].metadata.get("observation_source") == "simulation" for ref in selected.evidence_refs)
+    return ResolvedFact(**base, resolution_status="stale" if using_stale else "resolved",
+        freshness_status=FreshnessStatus.STALE if using_stale else FreshnessStatus.FRESH,
+        value=selected.value, selected_fact=selected,
+        selected_evidence=tuple(evidence[ref] for ref in sorted(supporting)),
+        conflicting_facts=conflicts, conflicting_evidence=tuple(evidence[ref] for ref in sorted(conflict_refs)),
+        confidence="limited" if using_stale or simulation else "corroborated" if corroborated else "policy_supported",
+        usable_as_current=not using_stale and not simulation,
+        reasons=("simulation_only_not_live_reality",) if simulation else ("stale_background_only",) if using_stale
+            else ("selected_by_fact_specific_policy_conflicts_preserved",) if conflicts else ("policy_supported_evidence",))
