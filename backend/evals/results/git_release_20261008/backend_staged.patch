+        location = str(poi.get("location", "")).split(",")
+        if len(location) != 2 or not poi.get("id") or not poi.get("name"):
+            continue
+        biz_ext = poi.get("biz_ext")
+        rating_raw = biz_ext.get("rating") if isinstance(biz_ext, dict) else None
+        try:
