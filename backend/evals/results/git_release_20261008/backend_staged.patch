+@pytest.mark.parametrize("text,clarify",[("杭州现在多少度？",False),("杭州昨天下午下雨了吗？",False),("西湖区明天天气？",True),("明天下午天气？",True),("杭州天气怎么样？",True),("杭州明天后天天气？",True)])
