POSTGRES_DB=roamsync
POSTGRES_USER=roamsync
POSTGRES_PASSWORD=123123
POSTGRES_HOST_PORT=54329
API_HOST_PORT=8000
WEB_HOST_PORT=3000
AMAP_WEB_KEY=
AMAP_ANDROID_KEY=
AMAP_SECURITY_CODE=
AMAP_REST_KEY=
ROAMSYNC_TAVILY_API_KEY=
DECISION_LEDGER_VALIDATION_MODE=shadow
TAVILY_BASE_URL=https://api.tavily.com
WEATHER_PROVIDER=open_meteo
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=10
ROUTE_CACHE_TTL_SECONDS=86400
ALLOW_MAP_ESTIMATES=false
AGENT_POLL_SECONDS=2
AGENT_LEASE_SECONDS=300
AGENT_WORKER_CONCURRENCY=2
AGENT_RUN_TIMEOUT_SECONDS=360
PLANNER_PROVIDER=glm
# Android debug backend: set to the computer's hotspot/LAN IPv4 address.
# Rebuild and reinstall the debug APK after changing this value.
ANDROID_API_BASE_URL=http://127.0.0.1:8000/
PLANNER_API_KEY=
PLANNER_BASE_URL=https://open.bigmodel.cn/api/paas/v4
PLANNER_MODEL=glm-5.3-flash
PLANNER_TIMEOUT_SECONDS=90
PLANNER_MAX_RETRIES=0
PLANNER_MAX_OUTPUT_TOKENS=20000
PLANNER_MAX_CANDIDATES=40
PLANNER_REASONING_EFFORT=high
INTENT_REASONING_EFFORT=max
ASSISTANT_SEMANTIC_TOOLS=true
RESEARCH_REASONING_EFFORT=low

# Optional model-only HTTP proxy. Docker Desktop can reach a host proxy through host.docker.internal.
PLANNER_PROXY_URL=

# Optional network proxy for destination web search.
TAVILY_PROXY_URL=
SEARCH_TIMEOUT_SECONDS=30
